# Copy to .env at the repo root. The server loads it on start.

PORT=8787
HOST=0.0.0.0

# Voice. When LIVEKIT_* is unset, rides use mesh (peer-to-peer) voice only.
# For local development run `npm run livekit:dev` (keys below are LiveKit's dev defaults).
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
DEFAULT_VOICE_MODE=livekit

# Mesh voice needs TURN on cellular networks (carrier NAT). Either static credentials...
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# ...or a coturn "use-auth-secret" shared secret (short-lived credentials are minted per rider).
TURN_SECRET=

# Shared destination routing: valhalla (motorcycle profile) | osrm | ors | mock
ROUTING_PROVIDER=valhalla
ORS_API_KEY=
# Place search: photon | nominatim | mock
GEOCODER=photon

MAX_RIDERS=8
# Extra origins allowed to open a socket (native app WebViews)
CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost
